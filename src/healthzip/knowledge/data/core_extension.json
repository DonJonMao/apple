    {
      "claim_id": "CORE-CLAIM-REST-HYPERTROPHY",
      "version": "1.4.2",
      "outcome": "rest",
      "requested_relation": "options",
      "scope": {
        "population": "healthy_adults",
        "time_scale": "multiweek_programs",
        "aggregation": "group_evidence",
        "goal": "hypertrophy"
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "S1在肌肥大结果中将组间休息列为资料不足、不能确定其影响的变量；不能把力量结果中所比较休息间隔的结论直接当作肌肥大结论。"
        },
        {
          "part_id": "2",
          "text": "因此这份来源不能给出所有人的唯一最优休息时长；讨论休息应明确目标、任务和所比较的方案。"
        }
      ],
      "source_spans": {
