      ]
    },
    {
      "claim_id": "CORE-CLAIM-GROUP-INDIVIDUAL",
      "version": "1.4.2",
      "outcome": "individual_effect",
      "requested_relation": "inference",
      "scope": {
        "population": "healthy_adults",
        "time_scale": "multiweek_programs",
        "aggregation": "group_evidence"
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "S1明确说明综述汇总的是群体证据，需要按照个体需求和目标作适当调整；其汇总设计也不能直接排列各种完整方案的比较效果。"
        },
        {
          "part_id": "2",
          "text": "个人完成一次任务或随后出现变化，只能先记录为执行与观察事实。这些群体汇总结果本身不建立该次任务对这个人的因果获益，也不提供个人成功概率。"
        }
      ],
      "source_spans": {
