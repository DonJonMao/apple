  "claims": [
    {
      "claim_id": "CORE-CLAIM-PROGRESSION-NECESSITY",
      "version": "1.4.2",
      "outcome": "progression_necessity",
      "requested_relation": "necessity",
      "scope": {
        "population": "healthy_adults",
        "time_scale": "multiweek_programs",
        "aggregation": "group_evidence"
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "这份健康成人综述明确区分“获得一些收益”和“追求持续的长期进展”：没有不断进阶，也不等于训练不可能带来收益。"
        },
        {
          "part_id": "2",
          "text": "为追求持续的长期进展，可能需要逐步改变刺激；何时和怎样改变仍应结合目标、经验和个体情况，不能承诺某个人下次提高。"
        }
      ],
      "source_spans": {
        "S1": [
          11,
          60,
          61,
          62,
          74
        ]
      },
      "limitations": [
        "实际核对来源及其范围；不构成个人最优数字、临床处方或一次训练因果效果证明。"
      ]
    },
    {
      "claim_id": "CORE-CLAIM-LOAD-REPETITION",
      "version": "1.4.2",
      "outcome": "load_repetition_relation",
      "requested_relation": "explanation",
      "scope": {
        "population": "healthy_adults",
        "time_scale": "multiweek_programs",
        "aggregation": "group_evidence"
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "在给定动作条件并接近疲劳的用力情况下，一组能够完成的重复次数与负荷存在反向关系；不同负荷后的次数不属于相同测试任务。"
        },
        {
          "part_id": "2",
          "text": "因此换成更重配重后次数减少，本身不能直接证明个人力量退步。可先保留负荷和次数事实，再在可比任务及测量条件下评价变化；该综述不提供个人确定换算或成功概率。"
        }
      ],
      "source_spans": {
        "S1": [
          11,
          62,
          70,
          74
        ]
      },
      "limitations": [
        "实际核对来源及其范围；不构成个人最优数字、临床处方或一次训练因果效果证明。"
      ]
    },
    {
      "claim_id": "CORE-CLAIM-SPECIFICITY",
      "version": "1.4.2",
      "outcome": "comparability",
      "requested_relation": "scope",
      "scope": {
        "population": "healthy_adults",
        "time_scale": "multiweek_programs",
        "aggregation": "group_evidence"
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "训练适应具有刺激特异性；该综述通常将力量结果定义为与训练模式相同的随意等张1RM，测量对象和方法应随解释一并保留。"
        },
        {
          "part_id": "2",
          "text": "来源的一般特异性原则并未证明任意器械之间可直接换算；该综述也明确指出部分结果的测试方法差异没有纳入综合，测量方法应在解释中保留。"
        }
      ],
      "source_spans": {
        "S1": [
          11,
          62,
          70,
          75
        ]
      },
      "limitations": [
        "实际核对来源及其范围；不构成个人最优数字、临床处方或一次训练因果效果证明。"
      ]
    },
    {
      "claim_id": "CORE-CLAIM-ADULT-SCOPE",
      "version": "1.4.2",
      "outcome": "population_scope",
      "requested_relation": "scope",
      "scope": {
        "population": "healthy_adults",
        "time_scale": "multiweek_programs",
        "aggregation": "group_evidence"
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "S1纳入至少18岁、无已定义疾病的健康成人，并明确排除其所定义的肥胖、肌少症和身体衰弱；不能把这个人群范围自动扩展为青少年、疾病或衰弱人群已验证方案。"
        },
        {
          "part_id": "2",
          "text": "综述包括不同训练经历，但大量证据来自经验较少者。其群体结果仍需要按个人目标和情况调整，不能从没有病历推断健康，也不能将未提供训练经历当成已知。"
        }
      ],
      "source_spans": {
        "S1": [
          11,
          67,
          74,
          75
        ]
      },
      "limitations": [
        "实际核对来源及其范围；不构成个人最优数字、临床处方或一次训练因果效果证明。"
      ]
    },
    {
      "claim_id": "CORE-CLAIM-FREQUENCY-VOLUME",
      "version": "1.4.3",
      "outcome": "frequency",
      "requested_relation": "options",
      "scope": {
        "population": "healthy_adults",
        "time_scale": "multiweek_programs",
        "aggregation": "group_evidence",
        "applicable_goals": [
          "strength",
          "hypertrophy"
        ]
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "S1将频次作为训练方案变量。其力量结果中频次有影响，但资料不足以确定完整剂量反应，而且总量相等时影响减弱。"
        },
        {
          "part_id": "2",
          "text": "在该综述的肌肥大比较中，总训练量相等时不同频次未显示同样的额外优势。安排天数应与目标、总量和可执行性一并考虑，不能据此给所有人唯一最优频次。"
        }
      ],
      "source_spans": {
        "S1": [
          11,
          25,
          26,
          69,
          74
        ]
      },
      "limitations": [
        "实际核对来源及其范围；不构成个人最优数字、临床处方或一次训练因果效果证明。"
      ]
    },
    {
      "claim_id": "CORE-CLAIM-GOAL-SCOPE",
      "version": "1.4.2",
      "outcome": "goal_scope",
      "requested_relation": "scope",
      "scope": {
        "population": "healthy_adults",
        "time_scale": "multiweek_programs",
        "aggregation": "group_evidence"
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "力量、肌肥大、功率和总体健康是不同目标；S1区分获得显著收益与追求最优收益，并强调按个人目标、经历和特点组织训练。",
          "source_spans": {
            "S1": [
              11,
              59,
              60,
              62,
              69,
              74
            ]
          }
        },
        {
          "part_id": "2",
          "text": "HHS成人章节给出总体健康层面的肌力活动建议；这不能自动成为某个人力量或增肌训练的唯一最优安排。选择目标之后，才可判断一条来源的范围是否相符。",
          "source_spans": {
            "S1": [
              62,
              74
            ],
            "CORE-US-HHS-PAG-2": [
              1,
              6
            ]
          }
        }
      ],
