      ]
    },
    {
      "claim_id": "CORE-CLAIM-GRADUAL-PROGRESSION",
      "version": "1.4.2",
      "outcome": "gradual_progression",
      "requested_relation": "options",
      "scope": {
        "population": "adults",
        "time_scale": "gradual_activity_program",
        "goal": "public_health"
      },
      "answer_parts": [
        {
          "part_id": "1",
          "text": "HHS建议逐步增加身体活动，结合当前体能和健康目标选择活动；增加量与通常活动量之间的差距以及适应、恢复都应考虑。"
        },
        {
          "part_id": "2",
          "text": "年龄、体能和既往经验影响个体化增加速度。正文的活动时间或百分比示例不是所有人的通用加重规则，也不能由这条指导确定下一档器械负重。"
        }
      ],
      "source_spans": {
        "CORE-US-HHS-PAG-2": [
