  "limitations": [
    "仅解释HHS第二版第4章18–64岁成人的一般健康建议与目标范围。",
    "最低健康建议不能单独确定个人力量或增肌训练的唯一最优安排，也不能据此断言每周两天不能增肌或不能提高力量。",
    "不提供个人训练数字、效果预测、个人任务校准或训练候选权限。",
    "审核身份是AI辅助，不是独立人工或专家验证。"
  ],
  "answer_parts": [
    {
      "part_id": "adult_health_scope",
      "text": "HHS《美国身体活动指南》第二版第4章面向18–64岁成人，解释有氧活动和肌力活动的一般健康益处；这里的建议以成人总体健康为目标。",
      "span_indices": [1, 2],
      "evidence_relation": "supports"
    },
    {
      "part_id": "muscle_strengthening_floor",
      "text": "该章建议每周至少两天进行中等或更高强度、涉及所有主要肌群的肌力活动，以获得额外健康益处；这是一般健康建议中的最低频次。",
      "span_indices": [1, 6, 8],
      "evidence_relation": "supports"
    },
    {
      "part_id": "optimization_limit",
      "text": "HHS同时要求考虑已有活动量、体能以及个人健康和体能目标，并允许逐步增加肌力活动至每周两天以上。因此，只凭这里的每周至少两天健康建议，不能推出某个人力量或增肌训练的唯一最优安排；这也不表示每周两天不能提高力量或不能增肌。",
      "span_indices": [6, 7, 8],
      "evidence_relation": "qualifies"
    }
  ],
