{
  "version": "personal-trial-policy-1.4.0",
  "allowed_reviewers": [
    "ai_assisted",
    "qualified_human_review",
    "independent_human"
  ],
  "capabilities": [
    "source_explanation",
    "plan_candidate",
    "trial_candidate"
  ],
  "requirements": [
    "exact_eligible_fulltext",
    "content_review",
    "application_review",
    "implementation_tests",
    "explicit_context"
  ],
  "requires_personal_causal_validation": false,
  "forbidden": [
    "individual_prediction",
    "causal_effect",
    "diagnosis",
    "automatic_clinical_prescription"
  ],
  "limit": "Personal fitness trial policy, not an independent expert endorsement or proof of individual effect."
}
