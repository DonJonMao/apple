{
  "version": "record-description-policy-1.4.0",
  "allowed_reviewers": [
    "ai_assisted",
    "qualified_human_review",
    "independent_human"
  ],
  "capabilities": [
    "description",
    "task_followup",
    "report"
  ],
  "requirements": [
    "explicit_record_contract",
    "implementation_tests",
    "application_review",
    "explicit_context"
  ],
  "evidence_basis": "product_record_contract",
  "forbidden": [
    "scientific_source_authority",
    "numeric_training_candidate",
    "individual_prediction",
    "causal_effect",
    "diagnosis"
  ],
  "limit": "Records may be compared, counted or linked under explicit software contracts; this supplies no scientific or candidate authority."
}
