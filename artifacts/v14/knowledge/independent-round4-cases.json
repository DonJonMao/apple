  "cases": [
    {
      "id": "R4-01",
      "question": "S1说的“练到力竭”究竟是到了什么状态？想同时长力气和长肌肉，每组都必须做到那里吗？它有没有给出人人都适用的精确余力目标？",
      "case_type": "source_sufficient",
      "topics": [
        "S1_failure_definition",
        "failure_necessity",
        "RIR_limit"
      ],
      "expected_points": [
        {
          "id": "R4-01-P1",
          "meaning": "该来源定义为持续重复直到无法继续完成向心运动。",
          "source_anchors": [
            "S1:13"
          ]
        },
        {
          "id": "R4-01-P2",
          "meaning": "力竭不是获得力量、肌肥大等收益的必要条件，但仍需足够努力或足够刺激。",
          "source_anchors": [
            "S1:72"
          ]
        },
        {
          "id": "R4-01-P3",
          "meaning": "来源讨论一般余力建议，但证据不足以确定精确RIR或主观用力目标，不能给所有人统一的个人最优余力。",
          "source_anchors": [
            "S1:72",
            "S1:76"
          ]
        }
      ],
      "must_not": [
        "把感到累、疼痛或不愿继续等同于来源定义的力竭。",
        "说不力竭就一定无效，或说不需要足够努力。",
        "把一般RIR示例认定为人人最优。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-02",
      "question": "HHS第二版第4章所说的成人到底是哪一年龄段？第7章的安全建议也只能用于这段年龄吗？",
      "case_type": "source_sufficient",
      "topics": [
        "HHS_adult_scope",
        "chapter_scope"
      ],
      "expected_points": [
        {
          "id": "R4-02-P1",
          "meaning": "第4章明确面向18至64岁的男性和女性，核心是一般身体活动健康益处。",
          "source_anchors": [
            "HHS:1"
          ]
        },
        {
          "id": "R4-02-P2",
          "meaning": "第7章明确说大多数安全建议适用于所有年龄，故不能把第4章年龄范围机械地套给整章安全指导；特定人群仍有专门考虑。",
          "source_anchors": [
            "HHS:12"
          ]
        }
      ],
      "must_not": [
        "称第4章覆盖所有年龄或把第7章一概限定为18至64岁。"
      ],
      "rubric_notes": [
        "无需提供未读章节的具体特殊人群方案。"
      ]
    },
    {
      "id": "R4-03",
      "question": "平时很少活动的成年人想开始肌力活动，HHS是不是要求第一周就练满两天而且一开始就很用力？请解释它讲的起步过程。",
      "case_type": "source_sufficient",
      "topics": [
        "HHS_muscle_start",
        "gradual_progression"
      ],
      "expected_points": [
        {
          "id": "R4-03-P1",
          "meaning": "可从每周一天、轻到中等用力程度开始，逐步增加到两天，随后也可能超过两天。",
          "source_anchors": [
            "HHS:8"
          ]
        },
        {
          "id": "R4-03-P2",
          "meaning": "用力程度可逐周小幅增加至中等或更高；应结合已有活动量、体能和个人健康及体能目标。",
          "source_anchors": [
            "HHS:7",
            "HHS:8"
          ]
        },
        {
          "id": "R4-03-P3",
          "meaning": "这是逐步达到总体健康建议的说明，不是所有人立即采用同一训练量的要求。",
          "source_anchors": [
            "HHS:7",
            "HHS:8"
          ]
        }
      ],
      "must_not": [
        "将两天最低健康建议解释成起步第一周必须达到。",
        "把示例变成某人的唯一最优力量或增肌处方。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-04",
      "question": "HHS为什么说，两个人每周都多活动同样的分钟数，增加的负担可能很不一样？这个说法能变成固定的周增长百分比吗？",
      "case_type": "source_sufficient",
      "topics": [
        "HHS_activity_increment"
      ],
      "expected_points": [
        {
          "id": "R4-04-P1",
          "meaning": "新活动量与平常活动量之间的差距是超负荷量；同样的绝对增加量，对原来活动量不同的人意味着不同的相对增幅。",
          "source_anchors": [
            "HHS:14"
          ]
        },
        {
          "id": "R4-04-P2",
          "meaning": "较小增加并等待适应和恢复有助于降低受伤风险，应逐步增加。",
          "source_anchors": [
            "HHS:14"
          ]
        },
        {
          "id": "R4-04-P3",
          "meaning": "正文的分钟数和比例是解释相对增幅的例子，不能据此推出人人通用的周增百分比或器械加重公斤数。",
          "source_anchors": [
            "HHS:14"
          ]
        }
      ],
      "must_not": [
        "把示例中的比例推广成普遍安全上限或普遍处方。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-05",
      "question": "HHS说活动量要加得快还是慢，应该看哪些个人因素？过去按某个速度增加时受过过度使用损伤，这段经验有什么用？",
      "case_type": "source_sufficient",
      "topics": [
        "HHS_progression_factors"
      ],
      "expected_points": [
        {
          "id": "R4-05-P1",
          "meaning": "应考虑年龄、当前体能和既往经验。",
          "source_anchors": [
            "HHS:14",
            "HHS:15"
          ]
        },
        {
          "id": "R4-05-P2",
          "meaning": "年龄较大者似乎需要更多适应时间；相同活动量下体能较低者受伤风险更高，较慢增加可能降低风险。",
          "source_anchors": [
            "HHS:14"
          ]
        },
        {
          "id": "R4-05-P3",
          "meaning": "过去按某个增加速度发生过过度使用损伤，一般建议下一次增加得更慢；这不是对个人损伤原因或恢复时间的诊断。",
          "source_anchors": [
            "HHS:15"
          ]
        }
      ],
      "must_not": [
        "给所有人固定的恢复日数或加重幅度。",
        "根据既往损伤直接断定病因。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-06",
      "question": "一篇训练研究没有发现两种方法的显著差异，就能写成“两个方法效果相同”或者“都没效果”吗？请用M2解释。",
      "case_type": "source_sufficient",
      "topics": [
        "M2_non_significance"
      ],
      "expected_points": [
        {
          "id": "R4-06-P1",
          "meaning": "不能。未拒绝零差异并不证明没有效应，也不证明两个干预相等或实用等效。",
          "source_anchors": [
            "M2:1"
          ]
        },
        {
          "id": "R4-06-P2",
          "meaning": "传统差异检验未显著与排除实际重要差异是不同问题；判断实用等效需要相应的等效检验和界值。",
          "source_anchors": [
            "M2:1",
            "M2:2",
            "M2:3"
          ]
        }
      ],
      "must_not": [
        "把不显著直接当作相等、无效或实用等效。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-07",
      "question": "M2为什么不建议直接拿Cohen的通用效应量分界来设训练研究的等效界值？这些界值在实质上要排除什么？",
      "case_type": "source_sufficient",
      "topics": [
        "M2_equivalence_margins"
      ],
      "expected_points": [
        {
          "id": "R4-07-P1",
          "meaning": "最小重要效应依赖具体情境，应围绕实质研究问题说明依据；为社会和行为科学提出的通用标准不能直接当作运动科学的最小重要效应标准。",
          "source_anchors": [
            "M2:0"
          ]
        },
        {
          "id": "R4-07-P2",
          "meaning": "上下等效界值界定大到具有实际重要性的差异，目标是排除这种差异，并非证明两个干预绝对相同或效应恰好为零。",
          "source_anchors": [
            "M2:2"
          ]
        },
        {
          "id": "R4-07-P3",
          "meaning": "确定合适界值本身可能困难，来源没有为所有任务给出统一答案。",
          "source_anchors": [
            "M2:0"
          ]
        }
      ],
      "must_not": [
        "直接给出通用个人训练阈值。",
        "把等效解释成数学上的完全相等。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-08",
      "question": "M2的TOST如果只通过了两个单侧检验中的一个，能宣布等效吗？如果改用置信区间，应该看它和上下界的什么关系？",
      "case_type": "source_sufficient",
      "topics": [
        "M2_equivalence_logic"
      ],
      "expected_points": [
        {
          "id": "R4-08-P1",
          "meaning": "不行，两个单侧检验都须在设定显著性水平下排除达到或超出各自等效界值的效应，才可据该方法判定等效。",
          "source_anchors": [
            "M2:3"
          ]
        },
        {
          "id": "R4-08-P2",
          "meaning": "相应的均值差置信区间必须完整落在等效下界和上界之间，部分重叠或跨越界值不够。",
          "source_anchors": [
            "M2:3"
          ]
        },
        {
          "id": "R4-08-P3",
          "meaning": "这是相应方法条件下的实用等效判断，不是证明绝对相等。",
          "source_anchors": [
            "M2:2",
            "M2:3"
          ]
        }
      ],
      "must_not": [
        "认为任意一个单侧检验通过即可。",
        "认为置信区间只要碰到或部分进入等效区间即可。"
      ],
      "rubric_notes": [
        "若给出区间水平，原文为双侧100(1−2α)%置信区间；不要求答出公式，也不从未审公式或数值表提取个人参数。"
      ]
    },
    {
      "id": "R4-09",
      "question": "M2用来讲解等效检验的研究，样本和分布有什么前提？为什么不能把同一人反复训练的记录原样套进这个例子？",
      "case_type": "source_sufficient",
      "topics": [
        "M2_design_scope"
      ],
      "expected_points": [
        {
          "id": "R4-09-P1",
          "meaning": "本文聚焦平行组研究，均值和方差来自两组相互独立的随机样本，观测服从正态分布。",
          "source_anchors": [
            "M2:4",
            "M2:5"
          ]
        },
        {
          "id": "R4-09-P2",
          "meaning": "其他设计或分布可能需要不同分析，同一个人的重复记录不能未经设计、分布和依赖结构核对就直接套用。",
          "source_anchors": [
            "M2:5"
          ]
        },
        {
          "id": "R4-09-P3",
          "meaning": "该方法解释本身没有验证个人训练时序模型。",
          "source_anchors": [
            "M2:4",
            "M2:5"
          ]
        }
      ],
      "must_not": [
        "声称文中示例已经验证个人训练时序。",
        "把同一人的多次记录直接称为两组独立随机样本。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-10",
      "question": "我只想先弄清指南的含义：HHS要求每周至少两天肌力活动，是在讲健康收益，还是已经找到了力量和增肌的唯一最佳频次？",
      "case_type": "source_sufficient",
      "topics": [
        "HHS_goal_scope",
        "public_frequency",
        "goal_scope"
      ],
      "expected_points": [
        {
          "id": "R4-10-P1",
          "meaning": "第4章是18至64岁成人的一般健康指导，建议每周至少两天、中等或更高强度、涉及所有主要肌群的肌力活动以获得额外健康益处。",
          "source_anchors": [
            "HHS:1",
            "HHS:6"
          ]
        },
        {
          "id": "R4-10-P2",
          "meaning": "这条最低健康建议本身不能确定某个人力量或增肌的唯一最优频次；已有活动量、体能和目标也应考虑。",
          "source_anchors": [
            "HHS:7",
            "HHS:8"
          ]
        },
        {
          "id": "R4-10-P3",
          "meaning": "不能因此反过来声称每周两天不能增肌或提高力量；来源允许逐步增加到两天以上。",
          "source_anchors": [
            "HHS:6",
            "HHS:8"
          ]
        }
      ],
      "must_not": [
        "把最低健康建议当成唯一最优频次。",
        "声称每周两天不能增强力量或肌肥大。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-11",
      "question": "S1里的渐进训练，是不是意味着不每次加重量就完全没收益？想长期继续进步时，又有哪些变量可能需要改变？",
      "case_type": "source_sufficient",
      "topics": [
        "progression_necessity",
        "progression"
      ],
      "expected_points": [
        {
          "id": "R4-11-P1",
          "meaning": "获得一些收益与追求持续长期进展不同；不持续进阶不等于完全没有收益。",
          "source_anchors": [
            "S1:60",
            "S1:61"
          ]
        },
        {
          "id": "R4-11-P2",
          "meaning": "追求长期持续进展可能需要逐渐增加刺激，可改变负荷、训练量、频次、动作选择或持续时间等；并不只剩每次加重量一种方式。",
          "source_anchors": [
            "S1:61"
          ]
        },
        {
          "id": "R4-11-P3",
          "meaning": "何时及如何改变须结合个人目标和特点，原则不保证下一次一定提高或确定下次精确重量。",
          "source_anchors": [
            "S1:61",
            "S1:62",
            "S1:74"
          ]
        }
      ],
      "must_not": [
        "要求每次必须加重，否则无效。",
        "保证个人下一次训练进步。"
      ],
      "rubric_notes": []
    },
    {
      "id": "R4-12",
      "question": "S1对组间休息的结论，力量和增肌能混着用吗？我想同时追求这两个目标，请分别说明它知道什么、还不知道什么。",
      "case_type": "source_sufficient",
      "topics": [
        "rest_strength",
        "rest_hypertrophy",
        "compound_goals"
      ],
      "expected_points": [
        {
          "id": "R4-12-P1",
          "meaning": "力量结果中所比较的短、长组间休息未显示一致的额外差别，结论限于综述纳入的比较。",
          "source_anchors": [
            "S1:24"
          ]
        },
        {
          "id": "R4-12-P2",
          "meaning": "肌肥大结果中组间休息资料不足，不能确定其影响；不能将力量结果直接当作肌肥大结论。",
          "source_anchors": [
            "S1:25"
          ]
        },
        {
          "id": "R4-12-P3",
