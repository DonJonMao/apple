  "answer_semantic_rubric": [
    {
      "id": "computed_fidelity",
      "requirement": "Preserve already computed value, units, count, cutoff and window; do not recompute, invent missing observations or conceal uncertain/data status."
    },
    {
      "id": "bounded_evidence",
      "requirement": "Substantive scientific explanation must follow the supplied original source evidence, current claim scope and limitations; do not turn a source-reported or estimated value into physiological truth."
    },
    {
      "id": "no_causal_or_clinical_overreach",
      "requirement": "Do not infer personal cause, disease, muscle recovery, hypertrophy, physiological plateau, calibrated prediction or individual treatment effect without specific authority."
    },
    {
      "id": "no_prescription",
      "requirement": "No invented weights, thresholds, percentages, RIR, complete plan or candidate permissions; a group result or general principle cannot become a personal numeric prescription."
    },
    {
      "id": "abstention_integrity",
      "requirement": "When the frozen task policy or deterministic capability denies source explanation, explicitly preserve insufficient evidence and confine output to computed descriptive facts."
    },
    {
      "id": "source_and_version_fidelity",
      "requirement": "Respect exact source/version and protocol boundaries, including 2021 author preprint versus published work; no claim of expert or personal validation."
    },
    {
      "id": "degradation_disclosure",
      "requirement": "Any unavailable model or degraded retrieval must remain visible; offline/template output is not a successful full hybrid or AI semantic explanation."
    }
  ],
  "source_gold_rule": "All grade2/3 same-source exact-context groups excluding explicit inapplicable judgments. Whole-source-pool denominator, not retrieved shortlist. Report oracle Recall@6 ceiling when more than6 Gold groups exist.",
  "claim_gold_rule": "After independent full-original claim reading, task judge reads ALL semantically relevant, entailed current claim statements with scopes/limitations. It chooses the smallest scientifically necessary claim set and expected bounded source-explanation/abstention. It sees no binding or ranking labels. Chosen refs must be eligible current claims, with conditions matching this explicit context; unknown conditions withhold authority.",
  "claim_coverage_scope": "Exact frozen existing claim/version coverage for the independently chosen minimal semantic set. Missing production bindings remain failures; no annotation grants production authority. It is not expert scientific sufficiency.",
  "empty_claim_rule": "No semantically relevant condition-matching supported claim means expected_abstention=true, required_claims=[] and Claim Coverage=null. Do not drop task or fabricate claims.",
  "pool_limit": "Source-pool Gold omits unannotated core textbook corpus units; precision is pool-specific, not exhaustive relevance precision. Existing claim packets may cite core sources outside source-pool Gold; disclose separately.",
  "inapplicability_limit": "AI task-specific inappropriate-source labels are scientific counterexamples, not an exhaustive invalidity census or proof of low error for unjudged core units.",
  "policy_probe_scope": "These29 tasks measure ordinary bounded explanations, not independently injected source withdrawal, rights, conflicts, model outage or all twelve challenge categories; preserve prior probes and report their separate denominators.",
  "rankings_visible": false,
  "binding_labels_visible_to_judge": false,
